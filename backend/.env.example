# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Auth/JWT
# JWT_SECRET should be changed per environment.
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=1800
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=1209600

# MySQL
MYSQL_PORT=3306
MYSQL_DATABASE=date
MYSQL_USER=date
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
