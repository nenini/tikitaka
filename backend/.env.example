# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Auth/JWT
# JWT_SECRET should be changed per environment.
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=1800
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=1209600

# MySQL
MYSQL_PORT=3306
MYSQL_DATABASE=date
MYSQL_USER=date
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# Password reset mail
PASSWORD_RESET_TOKEN_VALIDITY_SECONDS=900
PASSWORD_RESET_URL=http://localhost:3000/password-reset
MAIL_FROM=no-reply@example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_HEALTH_ENABLED=false

# OAuth2 login
FRONTEND_BASE_URL=http://localhost:5173
OAUTH_STATE_VALIDITY_SECONDS=300
OAUTH_SECURE_COOKIE=false
GOOGLE_OAUTH_CLIENT_ID=change-me
GOOGLE_OAUTH_CLIENT_SECRET=change-me
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/google/callback
NAVER_OAUTH_CLIENT_ID=change-me
NAVER_OAUTH_CLIENT_SECRET=change-me
NAVER_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/naver/callback

# Face analysis
FACE_ANALYSIS_REQUEST_VALIDITY_SECONDS=600

# AI chat server
# When the AI server runs on the host and Backend runs in Docker:
# AI_CHAT_BASE_URL=http://host.docker.internal:8000
AI_CHAT_BASE_URL=http://host.docker.internal:8000
AI_CHAT_STREAM_PATH=/api/v1/chat/stream
AI_CHAT_CONNECT_TIMEOUT=3s
AI_CHAT_REQUEST_TIMEOUT=270s
AI_CHAT_SSE_TIMEOUT=300s
AI_CHAT_INTERNAL_TOKEN=

# AI video session lifecycle events
# When the AI server runs on the host and Backend runs in Docker:
# AI_SESSION_BASE_URL=http://host.docker.internal:8000
AI_SESSION_BASE_URL=http://host.docker.internal:8000
AI_SESSION_EVENT_PATH=/api/v1/sessions/events
AI_SESSION_CONNECT_TIMEOUT=3s
AI_SESSION_REQUEST_TIMEOUT=5s
AI_SESSION_INTERNAL_TOKEN=
AI_SESSION_EVENT_MAX_ATTEMPTS=3
AI_SESSION_EVENT_RETRY_DELAY=1s

# AI session STT transcript lookup used when a moderation report is submitted
AI_TRANSCRIPT_BASE_URL=http://host.docker.internal:8000
AI_TRANSCRIPT_PATH_TEMPLATE=/api/v1/sessions/{sessionId}/transcript
AI_TRANSCRIPT_CONNECT_TIMEOUT=3s
AI_TRANSCRIPT_REQUEST_TIMEOUT=15s
AI_TRANSCRIPT_INTERNAL_TOKEN=
AI_TRANSCRIPT_MAX_ATTEMPTS=5
AI_TRANSCRIPT_RETRY_DELAY=2s
AI_REPORT_BASE_URL=http://host.docker.internal:8000
AI_REPORT_GENERATION_PATH=/internal/v1/session-reports/generate
AI_REPORT_CONNECT_TIMEOUT=3s
AI_REPORT_REQUEST_TIMEOUT=10s
AI_REPORT_MAX_ATTEMPTS=3
AI_REPORT_RETRY_DELAY=2s
AI_REPORT_GENERATION_TIMEOUT=5m
AI_REPORT_TIMEOUT_BATCH_SIZE=100
AI_REPORT_TIMEOUT_MONITOR_FIXED_DELAY_MS=30000
AI_REPORT_TIMEOUT_MONITOR_INITIAL_DELAY_MS=30000

# Peer evaluation submission window after session completion
RESULT_EVALUATION_SUBMISSION_WINDOW=48h

# LiveKit server API
# A LiveKit WS(S) URL is also accepted and normalized to HTTP(S) by Backend.
LIVEKIT_URL=http://host.docker.internal:7880
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me
LIVEKIT_EMPTY_TIMEOUT_SECONDS=600
LIVEKIT_MAX_PARTICIPANTS=3

# Waiting room entry window
ROOM_ENTRY_OPEN_BEFORE=10m
ROOM_ENTRY_CLOSE_AFTER=10m

# No-show policy (grace period / restriction durations by accumulated count)
NO_SHOW_GRACE_PERIOD=5m
NO_SHOW_FIRST_RESTRICTION=1d
NO_SHOW_SECOND_RESTRICTION=3d
NO_SHOW_REPEATED_RESTRICTION=7d
