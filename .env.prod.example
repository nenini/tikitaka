# Docker Compose
APP_VERSION=latest
BACKEND_PORT=8080

# MySQL - replace every example value on the server
MYSQL_DATABASE=date
MYSQL_USER=date
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# Authentication
JWT_SECRET=replace-with-at-least-32-bytes-random-secret
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=1800
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=1209600
PASSWORD_RESET_TOKEN_VALIDITY_SECONDS=900
PASSWORD_RESET_URL=https://i15a307.p.ssafy.io/password-reset

# Frontend / OAuth
FRONTEND_BASE_URL=https://i15a307.p.ssafy.io
OAUTH_STATE_VALIDITY_SECONDS=300
OAUTH_SECURE_COOKIE=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://i15a307.p.ssafy.io/api/v1/auth/oauth2/google/callback
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_REDIRECT_URI=https://i15a307.p.ssafy.io/api/v1/auth/oauth2/naver/callback

# Mail
MAIL_FROM=no-reply@i15a307.p.ssafy.io
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_HEALTH_ENABLED=false

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_EMPTY_TIMEOUT_SECONDS=600
LIVEKIT_MAX_PARTICIPANTS=3

# AI integration
AI_CHAT_BASE_URL=
AI_CHAT_STREAM_PATH=/api/v1/chat/stream
AI_CHAT_CONNECT_TIMEOUT=3s
AI_CHAT_REQUEST_TIMEOUT=60s
AI_CHAT_INTERNAL_TOKEN=
AI_SESSION_BASE_URL=http://host.docker.internal:18000
AI_SESSION_EVENT_PATH=/api/v1/sessions/events
AI_SESSION_CONNECT_TIMEOUT=3s
AI_SESSION_REQUEST_TIMEOUT=5s
AI_SESSION_INTERNAL_TOKEN=
AI_SESSION_EVENT_MAX_ATTEMPTS=3
AI_SESSION_EVENT_RETRY_DELAY=1s
AI_TRANSCRIPT_BASE_URL=
AI_TRANSCRIPT_PATH_TEMPLATE=/api/v1/sessions/{sessionId}/transcript
AI_TRANSCRIPT_CONNECT_TIMEOUT=3s
AI_TRANSCRIPT_REQUEST_TIMEOUT=15s
AI_TRANSCRIPT_INTERNAL_TOKEN=
AI_TRANSCRIPT_MAX_ATTEMPTS=5
AI_TRANSCRIPT_RETRY_DELAY=2s

# API documentation (enable only while it is needed)
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false

