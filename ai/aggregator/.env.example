# Backend와 AI 서버에 동일한 실제 토큰을 넣되, .env는 Git에 커밋하지 않습니다.
AI_SESSION_INTERNAL_TOKEN=replace-with-local-shared-secret
BACKEND_BASE_URL=http://localhost:8080

BACKEND_REQUEST_TIMEOUT_SECONDS=5
BACKEND_EVENT_MAX_ATTEMPTS=3
BACKEND_EVENT_RETRY_DELAY_SECONDS=1
AGGREGATOR_TICK_INTERVAL_SECONDS=0.5
AGGREGATOR_SHUTDOWN_FLUSH_TIMEOUT_SECONDS=3

# AI 서버는 Python 3.11 환경에서 STT 모델을 한 번만 공유해 사용합니다.
STT_MODEL_SIZE=large-v3
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_LANGUAGE=ko
STT_VAD_THRESHOLD=0.5
STT_END_SILENCE_MS=700
STT_MIN_CONFIDENCE=0.5
STT_MAX_PENDING=8

# Finalized text stays in AI process memory for this many seconds after a
# session ends. Debug text logs must remain disabled outside local validation.
TRANSCRIPT_RETENTION_SECONDS=1800
TRANSCRIPT_CLEANUP_INTERVAL_SECONDS=30
TRANSCRIPT_DEBUG_LOG=false
TRANSCRIPT_DEBUG_FULL_ON_SESSION_END=false

# Batch report LLM. Keep it on a separate GPU process from realtime coaching.
REPORT_LLM_BASE_URL=http://70.12.130.106:11500
REPORT_LLM_MODEL=exaone3.5:7.8b
REPORT_LLM_TIMEOUT_SECONDS=120
REPORT_MAX_CONCURRENCY=1
REPORT_SHUTDOWN_TIMEOUT_SECONDS=30

# Private EXAONE 3.5 7.8B server. Disabled means the fixed catalog is used.
COACHING_LLM_ENABLED=false
COACHING_LLM_BASE_URL=http://127.0.0.1:8100
COACHING_LLM_MODEL=LGAI-EXAONE/EXAONE-3.5-7.8B-Instruct
COACHING_LLM_TIMEOUT_SECONDS=3
COACHING_LLM_MAX_CONTEXT_UTTERANCES=10
COACHING_LLM_MAX_MESSAGE_CHARACTERS=100
