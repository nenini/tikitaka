# aggregator 빌드는 컨텍스트가 ai/ 다(pyproject 가 ../stt 를 참조하기 때문).
# 이 파일이 없으면 ai/ 전체 27GB 가 도커 데몬으로 전송된다 — 대부분 chatbot/finetune 24GB.

# 가상환경·캐시
**/.venv/
**/__pycache__/
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/
*.pyc

# 노드 의존성·빌드 산출물 (vision-analysis 는 FE 번들이라 이미지에 불필요)
**/node_modules/
**/dist/
**/coverage/

# 파인튜닝 데이터·체크포인트 (24GB)
chatbot/finetune/
chatbot/personas/

# 모델 아티팩트·오디오 (컨테이너에서 받거나 볼륨으로 붙인다)
**/artifacts/
**/fixtures/audio/
*.task
*.wasm
*.onnx
*.gguf

# 비밀·로컬 설정
**/.env
**/.env.*
*.pem
*.key

# 이미지에 들어갈 이유가 없는 것
**/tests/
**/.git/
*.md
