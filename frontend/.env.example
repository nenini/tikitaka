# ─────────────────────────────────────────────────────────────
# 프론트엔드 환경변수  ── 이 파일을 frontend/.env.local 로 복사해 값 채우기
#   ( .env.local 은 .gitignore(*.local) 대상이라 커밋되지 않음 )
# ─────────────────────────────────────────────────────────────

# [크로스-PC 연동] vite dev 프록시가 /api·/ws 를 포워딩할 백엔드 주소.
#   - 같은 PC:         비워두면 http://localhost:8080
#   - 백엔드가 다른 PC: http://<백엔드_PC_IP>:8080   (예: http://192.168.0.42:8080)
#   - docker compose:  http://backend:8080  (compose 가 자동 주입)
VITE_PROXY_TARGET=

# REST API 베이스 URL. 비워두면 '/api' 로 위 프록시를 탄다(브라우저 CORS 불필요 — 권장).
# 프록시 없이 백엔드로 직접 호출하려면 http://<백엔드_PC_IP>:8080/api (그때는 백엔드 CORS 설정 필요).
VITE_API_BASE_URL=

# WebSocket(STOMP) 엔드포인트 (시그널링/매칭 이벤트). 비워두면 /ws 프록시를 탄다.
VITE_WS_URL=

VITE_LIVEKIT_URL=
VITE_LIVEKIT_TOKEN_A=
VITE_LIVEKIT_TOKEN_B=