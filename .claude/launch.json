{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/gradlew.bat",
      "runtimeArgs": ["-p", "backend", "bootRun"],
      "port": 8080
    },
    {
      "name": "ai-face-analysis",
      "runtimeExecutable": "ai/face-analysis/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "face_analysis.api:app",
        "--app-dir",
        "ai/face-analysis/src",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "port": 8001
    }
  ]
}
